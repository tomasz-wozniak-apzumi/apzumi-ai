{
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); total=$(echo \"$input\" | jq -r '.context_window.context_window_size'); tokens=$(echo \"$input\" | jq -r '.context_window.total_input_tokens'); if [ -n \"$used\" ]; then ctx=$(printf \"ctx: %.0f%%\" \"$used\"); else ctx=$(printf \"ctx: %sk/%sk\" \"$(( tokens / 1000 ))\" \"$(( total / 1000 ))\"); fi; branch=$(git branch --show-current 2>/dev/null); if [ -n \"$branch\" ]; then echo \"$model | $branch | $ctx\"; else echo \"$model | $ctx\"; fi"
  },
